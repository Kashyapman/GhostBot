# ==========================================
# GHOSTBOT ENVIRONMENT VARIABLES (.env.example)
# ==========================================

# Core AI & LLM Cascade
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cloudflare AI (FLUX.1 Image Generation)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Voice & Text-to-Speech Engines
ELEVEN_API_KEY_1=your_eleven_labs_api_key_1_here
ELEVEN_API_KEY_2=your_eleven_labs_api_key_2_here
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Media, B-Roll, & Search APIs
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_KEY=your_pixabay_key_here
SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Advanced / Infrastructure Tokens
HF_API_KEY=your_huggingface_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
PUTER_AUTH_TOKEN=your_puter_auth_token_here

# Social Media & Publishing APIs
META_ACCESS_TOKEN=your_meta_access_token_here
FB_PAGE_ID=your_facebook_page_id_here
IG_USER_ID=your_instagram_user_id_here
YOUTUBE_TOKEN_JSON=your_youtube_token_json_here
